# Port for the frontend application (Vite)
PORT=3000

# Base URL path (defaults to root /)
BASE_PATH=/

# API Server Port
API_PORT=5000

# Gemini API key (for voice/UI streaming features)
GEMINI_API_KEY=

# PostgreSQL Database Connection URL (e.g., postgresql://postgres:password@localhost:5432/voice_ui_streamer)
DATABASE_URL=
